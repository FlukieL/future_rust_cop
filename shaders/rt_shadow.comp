#version 460
// The sun's shadow by rays (PLAN-RTX.md step 5, REG_DWORD `Shadows` 3): per pixel the place the
// game's depth gives (R of the shared G-buffer copy, view-space z), one ray toward the sun
// against the scene's TLAS; G = the share of rays blocked: a few rays into the sun disc give soft
// edges (penumbras grow with the distance to what casts), their noise is filtered in the AO's
// last pass. The strongest dynamic lights' shadows too: one ray from each pixel within a light's
// reach toward it, G += 2 * a bit per light blocked (the lights' pass, lights.rs). The ambient
// occlusion too (ao.rs, `RtAmbientOcclusion`): rays into the hemisphere above the pixel's surface
// (its normal from the depth), B = the share open within the AO's radius. Compiled to rt_shadow.spv by
// glslc --target-env=vulkan1.2 -O shaders/rt_shadow.comp -o shaders/rt_shadow.spv
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba32f) uniform image2D gbuf;
// the mission's texture pages, a bit per texel (1 covers; 2048 words a page)
layout(binding = 2, std430) readonly buffer Pages { uint covered[]; };
// models' and terrain's triangles: u0 v0 u1 v1 bytes, u2 v2 and the page from bit 16 (0xffff: no keyed texel);
// an instance's custom index: bit 23 a model, below it its first triangle's + 1
layout(binding = 3, std430) readonly buffer Materials { uvec2 mats[]; };
// the lights casting shadows: x of the first how many, y the share of its reach a ray ends short
// of its light (raytrace.rs LIGHT_SKIP); place (view space, x narrowed by
// widescreen's k as the lights' pass has it: lens.y) and reach
layout(binding = 4, std430) readonly buffer Lights { vec4 lcount; vec4 lights[8]; };
layout(push_constant) uniform View {
    // camera space to world space (columns), the camera's place (model units)
    mat4 axes;
    vec4 origin;
    // x focal length in pixels, y widescreen's x scale
    vec4 lens;
    // toward the sun in camera space (unscaled x)
    vec4 sun;
    // x tan of the sun disc's radius, y rays a pixel; z the AO's radius (0: none), w its rays a pixel
    vec4 soft;
} v;

// whether a ray from o along d meets something that covers (keyed texels let it through)
bool blocked(vec3 o, vec3 d, float far) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT, 0xff, o, 1.0, d, far);
    while (rayQueryProceedEXT(rq)) {
        // a triangle with keyed texels: blocks where its texel is not keyed out (black)
        int base = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false) & 0x7fffff;
        bool hit = true;
        if (base > 0) {
            uvec2 m = mats[base - 1 + rayQueryGetIntersectionPrimitiveIndexEXT(rq, false)];
            uint page = m.y >> 16;
            if (page != 0xffffu) {
                vec2 b = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                vec2 t0 = vec2(m.x & 255u, (m.x >> 8) & 255u);
                vec2 t1 = vec2((m.x >> 16) & 255u, m.x >> 24);
                vec2 t2 = vec2(m.y & 255u, (m.y >> 8) & 255u);
                uvec2 t = uvec2(clamp(t0 * (1.0 - b.x - b.y) + t1 * b.x + t2 * b.y, 0.0, 255.0));
                uint i = page * 65536u + t.y * 256u + t.x;
                if ((i >> 5) < uint(covered.length())) hit = ((covered[i >> 5] >> (i & 31u)) & 1u) != 0u;
            }
        }
        if (hit) rayQueryConfirmIntersectionEXT(rq);
    }
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// camera space (unscaled x) of pixel q at depth z (GL's first row is the bottom: y up)
vec3 C(ivec2 q, float z) {
    vec2 s = (vec2(q) + 0.5 - vec2(imageSize(gbuf)) * 0.5) * z / v.lens.x;
    return vec3(s.x / v.lens.y, s.y, z);
}
float Z(ivec2 q) {
    ivec2 size = imageSize(gbuf);
    return all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, size)) ? imageLoad(gbuf, q).r : 0.0;
}
// one axis of the surface at q along e, as ao.rs's T: from the side whose two pixels continue to
// q best in 1/z (not across an edge), both sides where q stands out and they fit each other
vec3 T(ivec2 q, float z, vec3 p, ivec2 e) {
    float za = Z(q + e), zb = Z(q - e), za2 = Z(q + 2 * e), zb2 = Z(q - 2 * e);
    if (za <= 0.0 && zb <= 0.0) return C(q + e, z) - p;
    if (zb <= 0.0) return C(q + e, za) - p;
    if (za <= 0.0) return p - C(q - e, zb);
    float iz = 1.0 / z;
    float pa = za2 > 0.0 ? 2.0 / za - 1.0 / za2 : 1.0 / za;
    float pb = zb2 > 0.0 ? 2.0 / zb - 1.0 / zb2 : 1.0 / zb;
    float ea = abs(pa - iz), eb = abs(pb - iz);
    if (min(ea, eb) > 0.002 * iz && abs(pa - pb) < 0.5 * min(ea, eb))
        return 0.5 * (C(q + e, za) - C(q - e, zb));
    return ea < eb ? C(q + e, za) - p : p - C(q - e, zb);
}
// the surface's normal at q in camera space, facing the camera
vec3 N(ivec2 q, float z, vec3 p) {
    vec3 n = cross(T(q, z, p, ivec2(1, 0)), T(q, z, p, ivec2(0, 1)));
    n = length(n) > 0.0 ? normalize(n) : vec3(0.0, 0.0, -1.0);
    return dot(n, p) > 0.0 ? -n : n;
}

// two numbers in 0..1 from a world cell (pcg3d): rays fixed to the world, not to the screen
vec2 hash(ivec3 c) {
    uvec3 v = uvec3(c) * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return vec2(v.xy) * (1.0 / 4294967296.0);
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gbuf);
    if (any(greaterThanEqual(q, size))) return;
    float z = imageLoad(gbuf, q).r;
    float shade = 0.0, open = 1.0;
    if (z > 0.0) {
        // GL's first row is the bottom: camera space has y up
        vec2 s = (vec2(q) + 0.5 - vec2(size) * 0.5) * z / v.lens.x;
        vec3 c = vec3(s.x / v.lens.y, s.y, z);
        vec3 p = mat3(v.axes) * c + v.origin.xyz;
        // a little toward the camera and off the surface along its normal: our triangles lie
        // within the game's rounding of its own, the surface must not shadow itself. Toward the
        // camera alone hardly lifts a point off ground seen at a flat angle (where the depth is
        // roughest too): shadows flickered on the ground ahead
        vec3 nw = normalize(mat3(v.axes) * N(q, z, c));
        float bias = 2.0 + 0.002 * z;
        vec3 o = p - normalize(mat3(v.axes) * c) * bias + nw * bias;
        vec3 d = normalize(mat3(v.axes) * v.sun.xyz);
        int n = int(v.soft.y);
        if (v.soft.x == 0.0) {
            shade = blocked(o, d, 1.0e5) ? 1.0 : 0.0;
        } else {
            // n points on the disc in rings of equal area, turned and shifted per pixel by
            // interleaved gradient noise: neighbours sample other points, the filter afterwards
            // averages them (one ray a pixel is enough for it)
            vec3 t = normalize(cross(d, abs(d.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
            vec3 u = cross(d, t);
            float turn = 6.2831853 * fract(52.9829189 * fract(dot(vec2(q), vec2(0.06711056, 0.00583715))));
            float shift = fract(52.9829189 * fract(dot(vec2(q) + vec2(47.0, 17.0), vec2(0.00583715, 0.06711056))));
            for (int i = 0; i < n; i++) {
                float a = float(i) * 2.3999632 + turn;
                float r = sqrt((float(i) + shift) / float(n)) * v.soft.x;
                if (blocked(o, normalize(d + r * (cos(a) * t + sin(a) * u)), 1.0e5)) shade += 1.0;
            }
            shade /= float(n);
        }
        // the AO: n rays cosine-weighted into the hemisphere above the surface, from a little
        // above it along its normal (not toward the camera: the start must not move when the
        // view turns), each as long as the radius. Turned and shifted by the world cell the
        // pixel shows (a power of 2 at most a pixel wide): a place keeps its rays while the view
        // moves (by the pixel, the noise left after the blur wandered over the surfaces)
        int an = int(v.soft.w);
        if (v.soft.z > 0.0 && an > 0) {
            vec3 ao = p + nw * (2.0 * bias);
            vec3 t = normalize(cross(nw, abs(nw.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
            vec3 u = cross(nw, t);
            float cell = exp2(floor(log2(max(z / v.lens.x, 0.125))));
            vec2 h = hash(ivec3(floor(p / cell)));
            float turn = 6.2831853 * h.x;
            float shift = h.y;
            float hits = 0.0;
            for (int i = 0; i < an; i++) {
                float a = float(i) * 2.3999632 + turn;
                float r = sqrt((float(i) + shift) / float(an));
                vec3 d = r * (cos(a) * t + sin(a) * u) + sqrt(max(1.0 - r * r, 0.0)) * nw;
                if (blocked(ao, normalize(d), v.soft.z)) hits += 1.0;
            }
            open = 1.0 - hits / float(an);
        }
        // the lights: within reach and not at the light's core (what holds it), as the lights'
        // pass decides in its space; the ray ends short of the light (what holds it)
        vec3 pn = vec3(s, z);
        int count = min(int(lcount.x), 8);
        for (int i = 0; i < count; i++) {
            float r = lights[i].w;
            float dn = distance(lights[i].xyz, pn);
            if (dn >= r || dn <= 0.1 * r) continue;
            vec3 lc = vec3(lights[i].x / v.lens.y, lights[i].y, lights[i].z);
            vec3 to = mat3(v.axes) * lc + v.origin.xyz - o;
            float len = length(to);
            float far = len - lcount.y * r;
            if (far > 1.0 && blocked(o, to / len, far)) shade += float(2 << i);
        }
    }
    imageStore(gbuf, q, vec4(z, shade, open, 0.0));
}
