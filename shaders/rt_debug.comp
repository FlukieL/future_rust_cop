#version 460
// FCOP_GBUFFER=rt (PLAN-RTX.md step 2): one ray per pixel from the game's camera against the
// scene's TLAS, shaded by what it hits. Compiled to rt_debug.spv by
// glslc --target-env=vulkan1.2 -O shaders/rt_debug.comp -o shaders/rt_debug.spv
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba8) uniform writeonly image2D picture;
layout(push_constant) uniform Camera {
    // camera space to world space (columns), the camera's place (model units)
    mat4 axes;
    vec4 origin;
    // x focal length in pixels of this picture, y widescreen's x scale
    vec4 lens;
} cam;

float hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
    return float(x & 0xffffu) / 65535.0;
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(picture);
    if (q.x >= size.x || q.y >= size.y) return;
    // the first row is the top; camera space has y up
    vec2 s = (vec2(q) + 0.5 - vec2(size) * 0.5) / cam.lens.x;
    vec3 d = normalize(mat3(cam.axes) * vec3(s.x / cam.lens.y, -s.y, 1.0));
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xff, cam.origin.xyz, 1.0, d, 1.0e6);
    while (rayQueryProceedEXT(rq)) {}
    vec3 c = vec3(0.04, 0.05, 0.10);
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        float t = rayQueryGetIntersectionTEXT(rq, true);
        int kind = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        uint id = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)) * 7919u + uint(rayQueryGetIntersectionInstanceIdEXT(rq, true)) * 104729u;
        vec3 base = kind == 0 ? vec3(0.95, 0.8, 0.3) : vec3(0.3, 0.95, 0.45);
        float face = 0.65 + 0.35 * hash(id);
        float fog = clamp(1.0 - t / 30000.0, 0.2, 1.0);
        c = base * face * fog * (rayQueryGetIntersectionFrontFaceEXT(rq, true) ? 1.0 : 0.55);
    }
    imageStore(picture, q, vec4(c, 1.0));
}
